# Copy to .env and fill in real values. .env is git-ignored; this file is not.

# Stage 2 (pipelines/foodcom/augment.py): LLM calls, billed per token.
ANTHROPIC_API_KEY=

# Postgres connection string (Supabase). Same name Alembic reads in alembic/env.py.
DATABASE_URL=

# dbt (dbt/profiles.yml reads these). Values come from the Supabase connection
# settings (Project Settings > Database); same database as DATABASE_URL above.
DBT_HOST=
DBT_PORT=5432
DBT_USER=
DBT_PASSWORD=
DBT_DBNAME=postgres
